{"nodes": [{"id": "claude_tradingproject", "label": "TradingProject (paper-trading research system)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1-L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal is verified data access, reproducible research and software-enforced risk controls; no strategy chosen; nothing promises profit. Owner is a beginner, so proposed/implemented/tested/verified behavior is kept separate."}, {"id": "claude_execution_boundary", "label": "Execution Boundary (hard rules)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L10-L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never submit/replace/cancel/close orders or change account settings without explicit owner approval of a later milestone; never enable live trading; no claims of unattended monitoring without a verified running service."}, {"id": "claude_allowed_hosts_guard", "label": "Allowed Hosts (paper-api and data.alpaca.markets only)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L15-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restricting hosts to paper trading and market data prevents any live-trading endpoint from being reached."}, {"id": "claude_read_only_client_rule", "label": "Read-only Alpaca Client Rule (HTTP GET only)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No write methods may be added to the client so data access cannot place or alter orders."}, {"id": "claude_order_submission_guard", "label": "Order Submission Guard (TRADING_MODE=paper, ORDER_SUBMISSION_ENABLED=true)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L18-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any future order code must pass through a single software switch that blocks by default."}, {"id": "claude_daytrading_starter_skill", "label": "daytrading-starter skill (planning/analysis only)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L20-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The skill does not authorize orders."}, {"id": "claude_credential_handling", "label": "Credential Handling (APCA_API_KEY_ID / APCA_API_SECRET_KEY in .env)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L24-L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys only in git-ignored .env or environment; never printed, logged, screenshotted, committed or asked for in chat; account snapshots exclude id and account_number."}, {"id": "claude_env_example", "label": ".env.example template", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_setup_procedure", "label": "Setup Procedure (venv + requirements.lock)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L32-L40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_requirements_lock", "label": "requirements.lock (full pip freeze)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L36-L40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_verification_commands", "label": "Verification Commands (pytest + verify_data_access)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L42-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_data_check_exit_codes", "label": "Data Check Exit Codes (0 success, 1 API failure, 2 no credentials)", "fi