# Copy this file to .env and fill in your own values. .env is git-ignored.
# Never put real keys in this example file.

# Alpaca PAPER-trading API keys (from the paper dashboard). These names are
# Alpaca's official ones and are also read from real environment variables.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Safety switches. Order submission stays disabled unless you deliberately
# change BOTH of these, and TRADING_MODE must remain "paper".
TRADING_MODE=paper
ORDER_SUBMISSION_ENABLED=false

# Optional: Anthropic API key for the model reviewer (Claude Console key, billed per token,
# separate from any Claude.ai or Claude Code subscription). Read only by command-line runs
# (python -m trading.jobs run / python -m trading.reviewer verify); the dashboard server never
# loads it. Leave empty until you have authorized a budget in research/MODEL_REVIEW_AUTHORIZATION.json.
ANTHROPIC_API_KEY=
